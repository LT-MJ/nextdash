// Nextdash — unified SEO / Blog CMS / E-commerce platform
// Prisma schema. PostgreSQL (Supabase) in production; see docs/database.md
// for the SQLite-for-local-dev option and the caveats that predate this
// switch (JSON-string fields instead of native arrays, Float money fields).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// AUTH / RBAC
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "super_admin", "seo_manager", "blog_editor"
  name        String
  description String?
  /// JSON string array of permission keys, e.g. ["seo.view","seo.edit"]
  permissions String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role            Role              @relation(fields: [roleId], references: [id])
  blogAuthor      BlogAuthor?
  activityLogs    ActivityLog[]
  auditRunsBy     SeoAuditRun[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([roleId])
}

// ============================================================================
// SEO — CORE
// ============================================================================

/// Polymorphic SEO record. One row per (entityType, entityId).
model SeoMetadata {
  id          String   @id @default(cuid())
  entityType  String // "page" | "post" | "product" | "category" | "tag" | "collection" | "author" | "homepage" | ...
  entityId    String

  title              String?
  description        String?
  focusKeyword       String?
  /// JSON string array
  additionalKeywords String?

  canonicalUrl  String?
  canonicalMode String  @default("AUTO") // AUTO | CUSTOM

  robotsIndex          Boolean @default(true)
  robotsFollow         Boolean @default(true)
  robotsNoarchive      Boolean @default(false)
  robotsNosnippet      Boolean @default(false)
  robotsNoimageindex   Boolean @default(false)
  robotsMaxSnippet     Int?
  robotsMaxImagePreview String? // none | standard | large
  robotsMaxVideoPreview Int?

  ogTitle       String?
  ogDescription String?
  ogImage       String?
  ogType        String?

  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  twitterCard        String? @default("summary_large_image")

  schemaType       String?
  /// JSON object — generated schema snapshot
  schemaJson       String?
  /// JSON object — user-supplied custom schema override
  schemaCustomJson String?

  seoScore          Int?
  seoGrade          String? // EXCELLENT | GOOD | NEEDS_IMPROVEMENT | CRITICAL
  /// JSON — full rule-by-rule breakdown
  seoScoreBreakdown String?
  analyzedAt        DateTime?
  contentHash       String?

  sitemapInclude  Boolean @default(true)
  breadcrumbLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([seoScore])
  @@index([entityType, robotsIndex])
}

model SeoRuleConfig {
  id           String  @id @default(cuid())
  key          String  @unique
  name         String
  category     String
  weight       Int     @default(1)
  severity     String  @default("WARNING") // PASS | WARNING | FAIL | INFO
  enabled      Boolean @default(true)
  /// JSON string array of content type keys this rule applies to; empty/null = all
  contentTypes String?
  /// JSON — rule-specific threshold overrides
  config       String?
}

model SeoContentTypeSettings {
  id                    String  @id @default(cuid())
  contentType           String  @unique
  label                 String
  titleTemplate         String?
  descriptionTemplate   String?
  robotsIndexDefault    Boolean @default(true)
  robotsFollowDefault   Boolean @default(true)
  schemaTypeDefault     String?
  sitemapEnabled        Boolean @default(true)
  seoEditorVisible      Boolean @default(true)
}

model SeoGlobalSettings {
  id                       String   @id @default("default")
  siteName                 String   @default("My Website")
  siteAlternateName        String?
  siteUrl                  String   @default("https://example.com")
  titleSeparator           String   @default("|")
  defaultTitleTemplate     String   @default("{title} {sep} {siteName}")
  defaultDescriptionTemplate String?
  defaultRobotsIndex       Boolean  @default(true)
  defaultRobotsFollow      Boolean  @default(true)
  orgType                  String   @default("Organization") // Organization | Person
  orgName                  String?
  orgDescription           String?
  orgLogo                  String?
  defaultSocialImage       String?
  contactEmail             String?
  contactPhone             String?
  /// JSON — { street, city, region, postalCode, country }
  address                  String?
  /// JSON string array of social profile URLs
  socialProfiles           String?
  searchPageNoindex        Boolean  @default(true)
  authorArchiveNoindex     Boolean  @default(false)
  dateArchiveNoindex       Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model LocalSeoSettings {
  id             String   @id @default("default")
  enabled        Boolean  @default(false)
  businessType   String   @default("LocalBusiness")
  businessName   String?
  streetAddress  String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  phone          String?
  email          String?
  /// JSON — { mon: "9-5", ... }
  openingHours   String?
  priceRange     String?
  latitude       Float?
  longitude      Float?
  logo           String?
  website        String?
  /// JSON string array
  socialProfiles String?
  updatedAt      DateTime @updatedAt
}

model SitemapSettings {
  id                 String   @id @default("default")
  enabled            Boolean  @default(true)
  includeImages      Boolean  @default(true)
  urlLimitPerFile    Int      @default(5000)
  /// JSON — { page: true, post: true, product: true, category: true, ... }
  contentTypeToggles String?
  /// JSON string array of excluded entityType:entityId keys
  excludedEntities   String?
  updatedAt          DateTime @updatedAt
}

model RobotsTxtSettings {
  id        String   @id @default("default")
  content   String   @default("User-agent: *\nAllow: /\n")
  updatedAt DateTime @updatedAt
}

model BreadcrumbSettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(true)
  separator    String   @default("›")
  homeLabel    String   @default("Home")
  homeUrl      String   @default("/")
  notFoundLabel String  @default("Page Not Found")
  updatedAt    DateTime @updatedAt
}

model Redirect {
  id          String    @id @default(cuid())
  source      String
  destination String
  statusCode  Int       @default(301)
  enabled     Boolean   @default(true)
  isRegex     Boolean   @default(false)
  hitCount    Int       @default(0)
  lastHitAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([source])
  @@index([enabled])
}

model NotFoundLog {
  id         String   @id @default(cuid())
  url        String
  referrer   String?
  userAgent  String?
  hitCount   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ignored    Boolean  @default(false)
  resolved   Boolean  @default(false)

  @@unique([url])
  @@index([resolved, ignored])
}

model IndexingQueueItem {
  id          String    @id @default(cuid())
  url         String
  action      String // SUBMIT | UPDATE | REMOVE
  provider    String // INDEXNOW | GOOGLE
  status      String    @default("PENDING") // PENDING | SUCCESS | FAILED
  response    String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

model SeoAuditRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  totalUrls  Int       @default(0)
  issuesFound Int      @default(0)
  /// JSON summary: counts by category/severity
  summary    String?
  initiatedById String?

  initiatedBy User?          @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  issues      SeoAuditIssue[]
}

model SeoAuditIssue {
  id          String   @id @default(cuid())
  auditRunId  String
  entityType  String
  entityId    String
  url         String
  category    String
  severity    String // CRITICAL | HIGH | MEDIUM | LOW
  ruleKey     String
  message     String
  createdAt   DateTime @default(now())

  auditRun SeoAuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)

  @@index([auditRunId])
  @@index([severity])
}

// ============================================================================
// MEDIA (shared between Blog + Commerce)
// ============================================================================

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  url         String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  caption     String?
  description String?
  folder      String?
  createdAt   DateTime @default(now())

  @@index([folder])
}

// ============================================================================
// CONTENT — PAGES
// ============================================================================

model Page {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  content       String    @default("")
  /// "html" (content is raw HTML) | "blocks" (content lives in `blocks`)
  contentFormat String    @default("html")
  /// JSON-stringified Block[] (src/lib/pages/blocks/types.ts) when contentFormat = "blocks"
  blocks        String?
  status        String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  homepageFor ReadingSettings[] @relation("ReadingSettingsHomepage")
  blogPageFor ReadingSettings[] @relation("ReadingSettingsBlogPage")

  @@index([status])
}

// ============================================================================
// SITE CHROME — MENUS, HEADER/FOOTER, READING (HOMEPAGE/BLOG-PAGE) SETTINGS
// ============================================================================

model Menu {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      MenuItem[]
  primaryFor HeaderFooterSettings[]
}

model MenuItem {
  id           String   @id @default(cuid())
  menuId       String
  parentId     String?
  label        String
  linkType     String   @default("CUSTOM") // CUSTOM | HOME | PAGE | POST | CATEGORY
  url          String? // used when linkType = CUSTOM
  targetId     String? // Page.id / BlogPost.id / BlogCategory.id when linkType is internal
  openInNewTab Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuItemTree")

  @@index([menuId])
  @@index([parentId])
}

model HeaderFooterSettings {
  id String @id @default("default")

  logoImageUrl String?
  logoAltText  String?
  logoText     String? // text-logo fallback when no image is set

  headerLayout  String  @default("logo-left-nav-right") // logo-left-nav-right | centered | logo-center-nav-below
  headerSticky  Boolean @default(false)
  primaryMenuId String?

  /// JSON array of { heading: string, menuId?: string, links?: {label,url}[] }
  footerColumns String?
  /// JSON array of { platform: string, url: string }
  socialLinks   String?
  copyrightText String  @default("© {year} {siteName}. All rights reserved.")

  updatedAt DateTime @updatedAt

  primaryMenu Menu? @relation(fields: [primaryMenuId], references: [id], onDelete: SetNull)
}

model ReadingSettings {
  id             String   @id @default("default")
  homepageMode   String   @default("DEFAULT") // DEFAULT | PAGE
  homepagePageId String?
  blogPageId     String?
  updatedAt      DateTime @updatedAt

  homepagePage Page? @relation("ReadingSettingsHomepage", fields: [homepagePageId], references: [id], onDelete: SetNull)
  blogPage     Page? @relation("ReadingSettingsBlogPage", fields: [blogPageId], references: [id], onDelete: SetNull)
}

// ============================================================================
// BLOG
// ============================================================================

model BlogAuthor {
  id             String  @id @default(cuid())
  userId         String? @unique
  name           String
  slug           String  @unique
  profileImage   String?
  bio            String?
  email          String?
  website        String?
  /// JSON string array
  socialProfiles String?

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts BlogPost[]
}

model BlogCategory {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String?
  parentId      String?
  featuredImage String?

  parent   BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children BlogCategory[] @relation("BlogCategoryTree")
  posts    BlogPost[]
}

model BlogTag {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?

  posts BlogPostTag[]
}

model BlogPost {
  id                 String    @id @default(cuid())
  slug               String    @unique
  title              String
  excerpt            String?
  content            String    @default("")
  featuredImage      String?
  /// JSON string array of image URLs
  gallery            String?
  authorId           String?
  categoryId         String?
  status             String    @default("DRAFT") // DRAFT | REVIEW | SCHEDULED | PUBLISHED | ARCHIVED
  visibility         String    @default("PUBLIC") // PUBLIC | PRIVATE
  publishedAt        DateTime?
  scheduledAt        DateTime?
  readingTimeMinutes Int?
  commentsEnabled    Boolean   @default(true)
  featured           Boolean   @default(false)
  viewCount          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  author     BlogAuthor?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category   BlogCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       BlogPostTag[]
  revisions  BlogPostRevision[]
  comments   BlogComment[]
  relatedTo  BlogPostRelation[] @relation("SourcePost")
  relatedBy  BlogPostRelation[] @relation("RelatedPost")

  @@index([status])
  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
}

model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogPostRelation {
  id            String @id @default(cuid())
  sourcePostId  String
  relatedPostId String
  manual        Boolean @default(true)

  sourcePost  BlogPost @relation("SourcePost", fields: [sourcePostId], references: [id], onDelete: Cascade)
  relatedPost BlogPost @relation("RelatedPost", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@unique([sourcePostId, relatedPostId])
}

model BlogPostRevision {
  id            String   @id @default(cuid())
  postId        String
  authorId      String?
  createdAt     DateTime @default(now())
  /// JSON snapshot of post fields at time of save
  snapshot      String
  /// JSON string array of changed field names
  changedFields String?

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model BlogComment {
  id          String   @id @default(cuid())
  postId      String
  authorName  String
  authorEmail String?
  content     String
  status      String   @default("PENDING") // PENDING | APPROVED | SPAM
  createdAt   DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
}

// ============================================================================
// E-COMMERCE
// ============================================================================

model ProductCategory {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  parentId    String?
  image       String?

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]
}

model Collection {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  image       String?
  type        String @default("MANUAL") // MANUAL | AUTOMATIC
  /// JSON — rule definition for AUTOMATIC collections
  rules       String?

  products CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  shortDescription String?
  sku              String?  @unique
  barcode          String?
  brand            String?
  categoryId       String?
  status           String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED | OUT_OF_STOCK
  visibility       String   @default("PUBLIC") // PUBLIC | HIDDEN
  featured         Boolean  @default(false)
  price            Float    @default(0)
  compareAtPrice   Float?
  costPrice        Float?
  currency         String   @default("USD")
  weight           Float?
  weightUnit       String   @default("kg")
  /// JSON string array of image URLs
  images           String?
  /// JSON — free-form spec key/value pairs
  specifications   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category    ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  collections CollectionProduct[]
  inventory   InventoryItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([status])
  @@index([categoryId])
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  sku            String? @unique
  name           String
  price          Float?
  compareAtPrice Float?
  barcode        String?
  image          String?
  weight         Float?
  /// JSON — { Size: "L", Color: "Red" }
  options        String?
  position       Int     @default(0)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory InventoryItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model InventoryItem {
  id               String   @id @default(cuid())
  productId        String?
  variantId        String?
  sku              String
  stock            Int      @default(0)
  reserved         Int      @default(0)
  reorderThreshold Int      @default(0)
  updatedAt        DateTime @updatedAt

  product     Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]

  @@index([productId])
  @@index([variantId])
}

model InventoryAdjustment {
  id              String   @id @default(cuid())
  inventoryItemId String
  delta           Int
  reason          String
  userId          String?
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
}

model Customer {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  phone       String?
  /// JSON — default address
  address     String?
  totalSpent  Float     @default(0)
  ordersCount Int       @default(0)
  lastOrderAt DateTime?
  createdAt   DateTime  @default(now())

  orders  Order[]
  reviews Review[]
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String // PERCENTAGE | FIXED
  value       Float
  minPurchase Float?
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int       @default(0)
  perCustomerLimit Int?
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean   @default(true)
  /// JSON string array of restricted product ids
  productRestrictions  String?
  /// JSON string array of restricted category ids
  categoryRestrictions String?
  createdAt   DateTime  @default(now())

  orders Order[]
}

model Order {
  id                 String    @id @default(cuid())
  orderNumber        String    @unique
  customerId         String?
  status             String    @default("PENDING") // PENDING | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentStatus      String    @default("UNPAID") // UNPAID | PAID | REFUNDED | FAILED
  fulfillmentStatus  String    @default("UNFULFILLED") // UNFULFILLED | FULFILLED | PARTIAL
  subtotal           Float     @default(0)
  discountTotal      Float     @default(0)
  shippingTotal      Float     @default(0)
  taxTotal           Float     @default(0)
  total              Float     @default(0)
  currency           String    @default("USD")
  couponId           String?
  /// JSON — shipping address
  shippingAddress    String?
  /// JSON — billing address
  billingAddress     String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  name      String
  sku       String?
  price     Float
  quantity  Int
  total     Float

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  authorName String
  rating     Int
  title      String?
  content    String?
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | SPAM
  createdAt  DateTime @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
}

// ============================================================================
// CROSS-CUTTING: ACTIVITY LOG / BACKGROUND JOBS
// ============================================================================

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  field      String?
  /// JSON
  oldValue   String?
  /// JSON
  newValue   String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model BackgroundJob {
  id           String    @id @default(cuid())
  type         String
  status       String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  startedAt    DateTime?
  finishedAt   DateTime?
  initiatedBy  String?
  /// JSON
  result       String?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([type])
}
