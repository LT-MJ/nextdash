# Database (SQLite by default — see docs/database.md to switch to PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth v5 — generate with `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-random-32+-char-secret"

# Public site URL used for canonical URLs, sitemap, JSON-LD, and IndexNow keyLocation
SITE_URL="http://localhost:3000"

# Optional: seed script admin login (see prisma/seed.ts) — defaults to admin@example.com / ChangeMe123! if unset
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional: IndexNow-compatible submission (spec §41). Generate any random key;
# it must also be reachable at https://{SITE_URL}/{key}.txt, which this app
# serves automatically once this is set (see src/app/[...catchall]/route.ts).
INDEXNOW_KEY=""

# Optional: Google Search Console integration (not yet implemented — see
# src/app/admin/(dashboard)/seo/analytics/page.tsx for the extension point).
# Never expose these to client-side code.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=""
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=""

# Optional: Google Analytics (GA4) integration (not yet implemented).
GOOGLE_ANALYTICS_PROPERTY_ID=""

# Required to enable the scheduled-maintenance endpoint (POST /api/cron).
# Generate with `openssl rand -hex 32`. Point your scheduler (Vercel Cron,
# a GitHub Actions cron workflow, a self-hosted cron job) at that endpoint
# with header: Authorization: Bearer <this value>
CRON_SECRET=""
